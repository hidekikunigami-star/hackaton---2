+import { Link } from 'react-router-dom'
+import { Anchor, ArrowRight, BookOpen, Compass, Flame, Lock, Newspaper, Scale, Target, Users } from 'lucide-react'
+import type { DashboardSummary, LogPose } from '../api/types'
+import { FRUIT_FILTERS, WANTED_STATUSES } from '../api/types'
+import { useAuth } from '../auth/AuthContext'
+import { EmptyState, ErrorState, PageHeading } from '../components/ui'
+import { berries, compactBerries, dateTime, FRUIT_LABEL, WANTED_STATUS_LABEL } from '../lib/format'
+import { useResource } from '../lib/useResource'
+
+function DashboardSkeleton() {
+  return (
+    <div aria-busy="true" aria-label="Cargando indicadores">
+      <div className="stats-grid">
+        {[0, 1, 2].map((i) => <div className="stat-card skeleton-block" key={i} style={{ height: 112 }} />)}
+      </div>
+      <div className="skeleton-block" style={{ height: 120, marginTop: 18, borderRadius: 10 }} />
+      <div className="skeleton-block" style={{ height: 220, marginTop: 18, borderRadius: 10 }} />
+    </div>
+  )
+}
+
+function LogPosePanel({ pose }: { pose: LogPose }) {
+  const unlocked = pose.status === 'UNLOCKED'
+  return (
+    <div className="pose-status-panel">
+      <div className="pose-emblem">{unlocked ? <Compass size={27} /> : <Lock size={24} />}</div>
+      <div className="pose-status-copy">
+        <span className="destination-number">REVERSE MOUNTAIN · CP3</span>
+        <h3>{unlocked ? 'Log Pose sincronizado' : 'Tu Log Pose espera la inspección'}</h3>
+        <p>{pose.message}{unlocked && pose.unlockedAt ? ` · Desde ${dateTime(pose.unlockedAt)}` : ''}</p>
+      </div>
+      <span className={`pose-badge ${unlocked ? 'unlocked' : ''}`}><span /> {unlocked ? 'UNLOCKED' : 'LOCKED'}</span>
+    </div>
+  )
+}
+
+export function Dashboard() {
+  const { session } = useAuth()
+  const summary = useResource<DashboardSummary>('/dashboard/summary')
+  const pose = useResource<LogPose>('/log-pose')
+
+  const retryAll = () => { summary.retry(); pose.retry() }
+  const failed = summary.state.status === 'error' ? summary.state.error : pose.state.status === 'error' ? pose.state.error : null
+  const loading = summary.state.status === 'loading' || pose.state.status === 'loading'
+
+  return (
+    <div className="page-content dashboard-page">
+      <PageHeading
+        eyebrow="EAST BLUE · PUESTO DE MANDO"
+        title="A la orden,"
+        highlight="capitán."
+        description={`${session?.team.name ?? 'Tu tripulación'} · ${session?.team.code ?? ''}. Estos son los indicadores de tu workspace.`}
+      />
+
+      {failed !== null ? (
+        <ErrorState error={failed} onRetry={retryAll} />
+      ) : loading || summary.state.status !== 'success' || pose.state.status !== 'success' ? (
+        <DashboardSkeleton />
+      ) : (
+        <DashboardContent data={summary.state.data} pose={pose.state.data} />
+      )}
+    </div>
+  )
+}
+
+function DashboardContent({ data, pose }: { data: DashboardSummary; pose: LogPose }) {
+  const unlocked = pose.status === 'UNLOCKED'
+  const empty = data.wanted.total === 0
+
+  return (
+    <>
+      <LogPosePanel pose={pose} />
+
+      {empty ? (
+        <div style={{ marginTop: 18 }}>
+          <EmptyState
+            title="Tu workspace aún no tiene carteles"
+            detail="Cuando la Guild registre carteles de 'Se Busca' en tu workspace, aquí verás sus indicadores."
+          />
+        </div>
+      ) : (
+        <>
+          <div className="section-title-row">
+            <div><div className="section-kicker"><span className="kicker-line" /> DATOS DE LA GUILD</div><h2>Estado del archivo</h2></div>
+            <span className="updated-label">CALCULADO {dateTime(data.generatedAt).toUpperCase()}</span>
+          </div>
+          <div className="stats-grid">
+            <article className="stat-card">
+              <div className="stat-card-top"><span>CARTELES</span><span className="stat-icon stat-icon-0"><Target size={18} /></span></div>
+              <div className="stat-value">{data.wanted.total.toLocaleString('es-PE')}</div>
+              <div className="stat-note"><span className="stat-dot" />{WANTED_STATUSES.map((s) => `${WANTED_STATUS_LABEL[s]}: ${data.wanted.byStatus[s]}`).join(' · ')}</div>
+            </article>
+            <article className="stat-card">
+              <div className="stat-card-top"><span>RECOMPENSA TOTAL</span><span className="stat-icon stat-icon-1"><Flame size={18} /></span></div>
+              <div className="stat-value" title={berries(data.wanted.totalBounty)}>{compactBerries(data.wanted.totalBounty)}</div>
+              <div className="stat-note"><span className="stat-dot" /><Scale size={12} /> Promedio {compactBerries(data.wanted.averageBounty)}</div>
+            </article>
+            <article className="stat-card">
+              <div className="stat-card-top"><span>TRIPULACIONES</span><span className="stat-icon stat-icon-2"><Users size={18} /></span></div>
+              <div className="stat-value">{data.crews.total.toLocaleString('es-PE')}</div>
+              <div className="stat-note"><span className="stat-dot" />{data.crews.mostWanted ? `Más buscada: ${data.crews.mostWanted.name}` : 'Sin tripulación destacada'}</div>
+            </article>
+          </div>
+
+          <div className="fruit-breakdown">
+            {FRUIT_FILTERS.map((f) => (
+              <Link key={f} to={`/wanted?fruit=${f}`} className="fruit-chip">
+                <span>{FRUIT_LABEL[f]}</span><b>{data.wanted.byFruit[f]}</b>
+              </Link>
+            ))}
+          </div>
+
+          <div className="section-title-row lower-title">
+            <div><div className="section-kicker"><span className="kicker-line" /> TOP RECOMPENSAS</div><h2>Los más buscados</h2></div>
+            <Link to="/wanted" className="text-link">Ver todos <ArrowRight size={14} /></Link>
+          </div>
+          <ol className="top-bounties">
+            {data.topBounties.map((w, i) => (
+              <li key={w.id}>
+                <Link to={`/wanted/${encodeURIComponent(w.id)}`}>
+                  <span className="top-rank">{String(i + 1).padStart(2, '0')}</span>
+                  <span className="top-name"><b>{w.name}</b><small>“{w.epithet}” · {w.crew.name}</small></span>
+                  <span className="top-bounty">{berries(w.bounty)}</span>
+                </Link>
+              </li>
+            ))}
+          </ol>
+        </>
+      )}
+
+      <div className="section-title-row lower-title">
+        <div><div className="section-kicker"><span className="kicker-line" /> PRÓXIMOS DESTINOS</div><h2>Tu ruta de navegación</h2></div>
+      </div>
+      <div className="destination-grid">
+        <Link to="/wanted" className="destination-card wanted-destination">
+          <div className="destination-icon"><Target size={21} /></div>
+          <div><span className="destination-number">01 / EAST BLUE</span><h3>Carteles de Se Busca</h3><p>Rastrea objetivos, filtra recompensas y revisa sus expedientes.</p></div>
+          <ArrowRight className="destination-arrow" size={18} />
+        </Link>
+        <Link to="/news" className={`destination-card ${unlocked ? 'news-destination' : 'locked-destination'}`}>
+          <div className="destination-icon">{unlocked ? <Newspaper size={21} /> : <Lock size={21} />}</div>
+          <div><span className="destination-number">02 / GRAND LINE · {unlocked ? 'ABIERTO' : 'BLOQUEADO'}</span><h3>News Coo</h3><p>{unlocked ? 'Sigue los reportes del mundo y verifica rumores.' : 'Requiere aprobar la inspección de Reverse Mountain.'}</p></div>
+          <ArrowRight className="destination-arrow" size={18} />
+        </Link>
+        <Link to="/sagas" className={`destination-card ${unlocked ? 'saga-destination' : 'locked-destination'}`}>
+          <div className="destination-icon">{unlocked ? <BookOpen size={21} /> : <Lock size={21} />}</div>
+          <div><span className="destination-number">03 / PONEGLYPH · {unlocked ? 'ABIERTO' : 'BLOQUEADO'}</span><h3>La Gran Saga</h3><p>Recorre las islas etapa por etapa.</p></div>
+          <ArrowRight className="destination-arrow" size={18} />
+        </Link>
+      </div>
+      <p className="dashboard-foot"><Anchor size={13} /> Datos en vivo de tu workspace.</p>
+    </>
+  )
+}
diff --git a/src/pages/news/NewsDetailPage.tsx b/src/pages/news/NewsDetailPage.tsx
new file mode 100644
index 0000000..78ce64c
--- /dev/null
+++ b/src/pages/news/NewsDetailPage.tsx
@@ -0,0 +1,125 @@
+import { useState } from 'react'
+import { Link, useLocation, useNavigate, useParams } from 'react-router-dom'
+import { ArrowLeft, Check, Newspaper, RotateCw, Shield, X } from 'lucide-react'
+import { api, ApiError, errorMessage } from '../../api/client'
+import type { NewsDetail } from '../../api/types'
+import { ErrorState, isLogPoseRequired, LoadingState, LogPoseRequired, NotFoundState } from '../../components/ui'
+import { dateTime, NEWS_PRIORITY_LABEL, NEWS_STATUS_LABEL, NEWS_TYPE_LABEL } from '../../lib/format'
+import { useResource } from '../../lib/useResource'
+import { applyNewsUpdate } from './newsStore'
+
+type Verdict = 'CONFIRMED' | 'DEBUNKED'
+
+export function NewsDetailPage() {
+  const { id = '' } = useParams()
+  const navigate = useNavigate()
+  const location = useLocation()
+  const { state, retry, setData } = useResource<NewsDetail>(`/news/${encodeURIComponent(id)}`)
+
+  const [pending, setPending] = useState<Verdict | null>(null)          // request en vuelo
+  const [failed, setFailed] = useState<{ verdict: Verdict; error: unknown } | null>(null)
+  const [notice, setNotice] = useState('')
+
+  const cameFromFeed = Boolean((location.state as { fromFeed?: boolean } | null)?.fromFeed)
+  function goBack() {
+    // Volver a la misma entrada del historial: el feed se reconstruye desde lo guardado, sin volver a pedirlo.
+    if (cameFromFeed) navigate(-1)
+    else navigate('/news')
+  }
+
+  async function verify(verdict: Verdict) {
+    if (pending) return
+    setPending(verdict)
+    setFailed(null)
+    setNotice('')
+    try {
+      const updated = await api<NewsDetail>(`/news/${encodeURIComponent(id)}/status`, { method: 'PATCH', body: { status: verdict } })
+      setData(updated)
+      applyNewsUpdate(updated) // el feed reflejará el nuevo estado al volver
+      setNotice(verdict === 'CONFIRMED' ? 'Listo: la noticia quedó CONFIRMADA.' : 'Listo: la noticia quedó DESMENTIDA.')
+    } catch (error) {
+      // 409: otra persona ya la verificó con el otro estado → mostramos el estado real que devuelve el servidor.
+      if (error instanceof ApiError && error.code === 'NEWS_ALREADY_VERIFIED' && error.body?.current) {
+        setData(error.body.current)
+        applyNewsUpdate(error.body.current)
+        setNotice(`Esta noticia ya había sido verificada como ${NEWS_STATUS_LABEL[error.body.current.status].toUpperCase()}.`)
+      } else {
+        // El estado anterior se conserva (no tocamos los datos) y se permite reintentar.
+        setFailed({ verdict, error })
+      }
+    } finally {
+      setPending(null)
+    }
+  }
+
+  return (
+    <div className="page-content detail-page">
+      <button className="back-link" onClick={goBack}><ArrowLeft size={16} /> Volver a News Coo</button>
+
+      {state.status === 'loading' && <LoadingState text="Abriendo el reporte…" />}
+      {state.status === 'error' && (
+        isLogPoseRequired(state.error) ? <LogPoseRequired />
+          : state.error instanceof ApiError && state.error.status === 404
+            ? <NotFoundState title="Noticia no encontrada" detail="Esta noticia no existe en tu workspace." backTo="/news" backLabel="Ir al feed" />
+            : <ErrorState error={state.error} onRetry={retry} />
+      )}
+
+      {state.status === 'success' && (() => {
+        const n = state.data
+        return (
+          <article className="news-detail">
+            <div className="section-kicker"><span className="kicker-line" /> NEWS COO · {n.source.toUpperCase()}</div>
+            <div className="news-detail-tags">
+              <span className="news-type">{NEWS_TYPE_LABEL[n.type]}</span>
+              <span className={`news-status status-${n.status.toLowerCase()}`}>{NEWS_STATUS_LABEL[n.status]}</span>
+              <span className="news-date">{dateTime(n.publishedAt)}</span>
+            </div>
+            <h1>{n.title}</h1>
+            <p className="news-detail-lede">{n.summary}</p>
+            <div className="news-detail-byline">
+              <span className="byline-icon"><Newspaper size={17} /></span>
+              <div><b>{n.source}</b><small>{n.island}</small></div>
+              <span className={`priority-label priority-text-${n.priority.toLowerCase()}`}>PRIORIDAD {NEWS_PRIORITY_LABEL[n.priority].toUpperCase()}</span>
+            </div>
+            <div className="news-article-body">{n.body.map((paragraph, i) => <p key={i}>{paragraph}</p>)}</div>
+            {n.relatedWanted && (
+              <p className="related-wanted">Cartel relacionado: <Link to={`/wanted/${encodeURIComponent(n.relatedWanted.id)}`}>{n.relatedWanted.name}</Link></p>
+            )}
+
+            {notice && <div className="success-box" role="status"><Check size={16} /><span>{notice}</span></div>}
+            {failed && (
+              <div className="error-box" role="alert">
+                <X size={16} />
+                <span>No se pudo guardar la verificación: {errorMessage(failed.error)} La noticia sigue como {NEWS_STATUS_LABEL[n.status].toUpperCase()}.</span>
+                <button className="secondary-btn" onClick={() => void verify(failed.verdict)} disabled={pending !== null}><RotateCw size={14} /> Reintentar</button>
+              </div>
+            )}
+
+            {n.status === 'RUMOR' ? (
+              <div className="verify-panel">
+                <div>
+                  <div className="section-kicker"><span className="kicker-line" /> VERIFICACIÓN DE LA GUILD</div>
+                  <h3>¿Este rumor es cierto?</h3>
+                  <p>Solo los rumores se pueden verificar. El cambio es permanente en tu workspace.</p>
+                </div>
+                <div className="verify-actions">
+                  <button className="confirm-btn" disabled={pending !== null} onClick={() => void verify('CONFIRMED')}>
+                    {pending === 'CONFIRMED' ? <span className="spinner" /> : <Check size={16} />} Confirmar
+                  </button>
+                  <button className="debunk-btn" disabled={pending !== null} onClick={() => void verify('DEBUNKED')}>
+                    {pending === 'DEBUNKED' ? <span className="spinner" /> : <X size={16} />} Desmentir
+                  </button>
+                </div>
+              </div>
+            ) : (
+              <div className="verified-panel">
+                <Shield size={19} />
+                <span>Reporte {NEWS_STATUS_LABEL[n.status].toUpperCase()}{n.verifiedAt ? ` el ${dateTime(n.verifiedAt)}` : ''}.</span>
+              </div>
+            )}
+          </article>
+        )
+      })()}
+    </div>
+  )
+}
diff --git a/src/pages/news/NewsFeedPage.tsx b/src/pages/news/NewsFeedPage.tsx
new file mode 100644
index 0000000..90d08c0
--- /dev/null
+++ b/src/pages/news/NewsFeedPage.tsx
@@ -0,0 +1,267 @@
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react'
+import { Link, useSearchParams } from 'react-router-dom'
+import { ArrowRight, Globe2, Newspaper, RotateCw } from 'lucide-react'
+import { api, ApiError, errorMessage } from '../../api/client'
+import { NEWS_PRIORITIES, NEWS_STATUSES, NEWS_TYPES, pickEnum } from '../../api/types'
+import type { NewsFeed, NewsItem } from '../../api/types'
+import { EmptyState, ErrorState, isLogPoseRequired, LogPoseRequired, PageHeading } from '../../components/ui'
+import { dateTime, NEWS_PRIORITY_LABEL, NEWS_STATUS_LABEL, NEWS_TYPE_LABEL } from '../../lib/format'
+import { filtersToParams, getFeed, parseNewsFilters, saveFeed, type NewsFilters } from './newsStore'
+
+const PAGE_LIMIT = 20
+
+interface FeedState {
+  key: string            // filtros a los que pertenece este estado
+  items: NewsItem[]
+  nextCursor: string | null
+  hasMore: boolean
+  started: boolean       // ya llegó la primera carga
+  loading: boolean
+  error: unknown | null
+}
+
+function emptyFeed(key: string): FeedState {
+  return { key, items: [], nextCursor: null, hasMore: true, started: false, loading: false, error: null }
+}
+
+function feedFromCache(key: string): FeedState | null {
+  const cached = getFeed(key)
+  if (!cached) return null
+  return { key, items: cached.items, nextCursor: cached.nextCursor, hasMore: cached.hasMore, started: true, loading: false, error: null }
+}
+
+function isCursorError(error: unknown): boolean {
+  return error instanceof ApiError && (error.code === 'INVALID_CURSOR' || error.code === 'CURSOR_FILTER_MISMATCH')
+}
+
+export function NewsFeedPage() {
+  const [params, setParams] = useSearchParams()
+  const filters = useMemo(() => parseNewsFilters(params), [params])
+  const key = filtersToParams(filters).toString()
+
+  // URL con valores inválidos → se normaliza (replace).
+  useEffect(() => {
+    if (params.toString() !== key) setParams(new URLSearchParams(key), { replace: true })
+  }, [params, key, setParams])
+
+  const [state, setState] = useState<FeedState>(() => feedFromCache(key) ?? emptyFeed(key))
+  const stateRef = useRef(state)
+  stateRef.current = state
+
+  const keyRef = useRef(key)            // filtros vigentes
+  const inFlight = useRef(false)        // una sola carga en vuelo
+  const controllerRef = useRef<AbortController | null>(null)
+  const lastScrollY = useRef(0)
+  const pendingScroll = useRef<number | null>(getFeed(key)?.scrollY ?? null)
+
+  const loadPage = useCallback(async (forKey: string, cursor: string | null) => {
+    if (inFlight.current) return
+    inFlight.current = true
+    const controller = new AbortController()
+    controllerRef.current = controller
+    setState((s) => (s.key === forKey ? { ...s, loading: true, error: null } : s))
+    try {
+      const query = new URLSearchParams(forKey)
+      query.set('limit', String(PAGE_LIMIT))
+      if (cursor) query.set('cursor', cursor)
+      const res = await api<NewsFeed>(`/news/feed?${query.toString()}`, { signal: controller.signal })
+      // Si mientras tanto cambiaron los filtros, esta respuesta es de otro feed: se descarta (nunca se mezclan).
+      if (controller.signal.aborted || keyRef.current !== forKey) return
+      setState((s) => {
+        if (s.key !== forKey) return s
+        // Regla de Nami: ninguna noticia aparece dos veces.
+        const seen = new Set(s.items.map((item) => item.id))
+        const fresh: NewsItem[] = []
+        for (const item of res.items) {
+          if (!seen.has(item.id)) { seen.add(item.id); fresh.push(item) }
+        }
+        return {
+          ...s,
+          items: [...s.items, ...fresh],
+          nextCursor: res.nextCursor,
+          hasMore: res.hasMore && res.nextCursor !== null,
+          started: true,
+          loading: false,
+          error: null,
+        }
+      })
+    } catch (error) {
+      if (controller.signal.aborted || keyRef.current !== forKey) return
+      // Un error NO borra lo que ya estaba cargado.
+      setState((s) => (s.key === forKey ? { ...s, loading: false, error } : s))
+    } finally {
+      if (controllerRef.current === controller) {
+        controllerRef.current = null
+        inFlight.current = false
+      }
+    }
+  }, [])
+
+  // Cambio de filtros: se cancela la carga en vuelo y se empieza de cero (o desde lo guardado).
+  useEffect(() => {
+    keyRef.current = key
+    const cached = feedFromCache(key)
+    if (cached) {
+      setState(cached)
+    } else {
+      setState(emptyFeed(key))
+      void loadPage(key, null)
+    }
+    return () => {
+      controllerRef.current?.abort()
+      controllerRef.current = null
+      inFlight.current = false
+    }
+  }, [key, loadPage])
+
+  // Guardar el feed (para volver del detalle sin pedir de nuevo lo que ya teníamos).
+  useEffect(() => {
+    if (state.started && state.items.length > 0) {
+      saveFeed(state.key, { items: state.items, nextCursor: state.nextCursor, hasMore: state.hasMore, scrollY: lastScrollY.current })
+    }
+  }, [state])
+
+  // Registrar la posición de scroll y guardarla al salir.
+  useEffect(() => {
+    let frame = 0
+    const onScroll = () => {
+      cancelAnimationFrame(frame)
+      frame = requestAnimationFrame(() => { lastScrollY.current = window.scrollY })
+    }
+    window.addEventListener('scroll', onScroll, { passive: true })
+    return () => {
+      window.removeEventListener('scroll', onScroll)
+      cancelAnimationFrame(frame)
+      const s = stateRef.current
+      if (s.started && s.items.length > 0) {
+        saveFeed(s.key, { items: s.items, nextCursor: s.nextCursor, hasMore: s.hasMore, scrollY: lastScrollY.current })
+      }
+    }
+  }, [])
+
+  // Al volver del detalle: restaurar la posición exacta.
+  useLayoutEffect(() => {
+    if (pendingScroll.current === null || !state.started) return
+    window.scrollTo(0, pendingScroll.current)
+    lastScrollY.current = pendingScroll.current
+    pendingScroll.current = null
+  }, [state.started])
+
+  // Infinite scroll: un IntersectionObserver vigila un "sentinel" al final de la lista.
+  const sentinelRef = useRef<HTMLDivElement>(null)
+  const loadMore = useCallback(() => {
+    const s = stateRef.current
+    if (!s.started || s.loading || s.error !== null || !s.hasMore || !s.nextCursor) return
+    void loadPage(s.key, s.nextCursor)
+  }, [loadPage])
+
+  useEffect(() => {
+    const node = sentinelRef.current
+    if (!node || !state.started || state.loading || state.error !== null || !state.hasMore) return
+    // Se re-observa tras cada carga: si el sentinel sigue visible (lista corta), se dispara de nuevo.
+    const observer = new IntersectionObserver((entries) => {
+      if (entries.some((entry) => entry.isIntersecting)) loadMore()
+    }, { rootMargin: '600px 0px' })
+    observer.observe(node)
+    return () => observer.disconnect()
+  }, [state.started, state.loading, state.error, state.hasMore, state.items.length, loadMore])
+
+  function retry() {
+    const s = stateRef.current
+    if (!s.started || isCursorError(s.error)) {
+      // Primera carga fallida o cursor inválido: se empieza de cero.
+      setState(emptyFeed(s.key))
+      void loadPage(s.key, null)
+    } else {
+      void loadPage(s.key, s.nextCursor)
+    }
+  }
+
+  function updateFilter(patch: NewsFilters) {
+    setParams(filtersToParams({ ...filters, ...patch }))
+  }
+
+  function rememberScroll() { lastScrollY.current = window.scrollY }
+
+  const view = state.key === key ? state : (feedFromCache(key) ?? emptyFeed(key))
+
+  return (
+    <div className="page-content">
+      <PageHeading
+        eyebrow="GRAND LINE · NEWS COO"
+        title="El mundo"
+        highlight="no se detiene."
+        description="Rumores, reportes y noticias del Grand Line. Verifica los rumores desde el detalle."
+        action={<span className="count-pill"><Globe2 size={15} /> {view.items.length} cargadas</span>}
+      />
+
+      <div className="news-filter-bar">
+        <div className="news-filter-title"><Newspaper size={17} /><span>FILTRO DE TRANSMISIONES</span></div>
+        <label><span>Tipo</span>
+          <select value={filters.type ?? ''} onChange={(e) => updateFilter({ type: pickEnum(NEWS_TYPES, e.target.value) })}>
+            <option value="">Todos</option>
+            {NEWS_TYPES.map((t) => <option key={t} value={t}>{NEWS_TYPE_LABEL[t]}</option>)}
+          </select>
+        </label>
+        <label><span>Prioridad</span>
+          <select value={filters.priority ?? ''} onChange={(e) => updateFilter({ priority: pickEnum(NEWS_PRIORITIES, e.target.value) })}>
+            <option value="">Todas</option>
+            {NEWS_PRIORITIES.map((p) => <option key={p} value={p}>{NEWS_PRIORITY_LABEL[p]}</option>)}
+          </select>
+        </label>
+        <label><span>Estado</span>
+          <select value={filters.status ?? ''} onChange={(e) => updateFilter({ status: pickEnum(NEWS_STATUSES, e.target.value) })}>
+            <option value="">Todos</option>
+            {NEWS_STATUSES.map((s) => <option key={s} value={s}>{NEWS_STATUS_LABEL[s]}</option>)}
+          </select>
+        </label>
+      </div>
+
+      {isLogPoseRequired(view.error) ? (
+        <LogPoseRequired />
+      ) : !view.started && view.error !== null ? (
+        <ErrorState error={view.error} onRetry={retry} />
+      ) : !view.started ? (
+        <div className="news-feed" aria-busy="true">
+          {Array.from({ length: 5 }, (_, i) => <div key={i} className="news-card skeleton-block" style={{ height: 132 }} />)}
+        </div>
+      ) : view.items.length === 0 && !view.hasMore ? (
+        <EmptyState title="Silencio en las ondas" detail="No hay noticias con estos filtros." />
+      ) : (
+        <div className="news-feed">
+          {view.items.map((item) => <NewsCard key={item.id} item={item} onOpen={rememberScroll} />)}
+          <div ref={sentinelRef} className="feed-sentinel" aria-hidden="true" />
+          {view.loading && <div className="feed-loading" role="status"><span className="spinner dark-spinner" /> Recibiendo nuevas transmisiones…</div>}
+          {view.error !== null && (
+            <div className="inline-error" role="alert">
+              <span>{errorMessage(view.error)} Las noticias ya cargadas se conservan.</span>
+              <button className="secondary-btn" onClick={retry}><RotateCw size={14} /> Reintentar</button>
+            </div>
+          )}
+          {!view.hasMore && !view.loading && <div className="feed-end"><span /> FIN DE TRANSMISIÓN · {view.items.length} noticias <span /></div>}
+        </div>
+      )}
+    </div>
+  )
+}
+
+function NewsCard({ item, onOpen }: { item: NewsItem; onOpen: () => void }) {
+  return (
+    <Link to={`/news/${encodeURIComponent(item.id)}`} state={{ fromFeed: true }} className="news-card" onClick={onOpen}>
+      <div className={`news-priority priority-${item.priority.toLowerCase()}`} />
+      <div className="news-card-content">
+        <div className="news-meta">
+          <span className="news-type">{NEWS_TYPE_LABEL[item.type]}</span>
+          <span className={`news-status status-${item.status.toLowerCase()}`}>{NEWS_STATUS_LABEL[item.status]}</span>
+          <span className="news-date">{dateTime(item.publishedAt)}</span>
+        </div>
+        <h3>{item.title}</h3>
+        <p>{item.summary}</p>
+        <div className="news-card-bottom">
+          <span>{item.source} · {item.island} · Prioridad {NEWS_PRIORITY_LABEL[item.priority]}</span>
+          <span className="read-report">LEER REPORTE <ArrowRight size={14} /></span>
+        </div>
+      </div>
+    </Link>
+  )
+}
